# Copy this file to .env before running `docker compose up`.
# Never commit the real .env file.

# Base URL the browser uses to call the API. It is resolved by the browser, so
# it is localhost even though the backend runs in its own container.
VITE_API_BASE_URL=http://localhost:8090/api/v1

# Where the Vite dev server proxies /api to. Inside Docker the backend is a
# separate compose project, reached through the host's published port.
VITE_PROXY_TARGET=http://host.docker.internal:8090

# Host ports.
FRONTEND_PORT=5180
FRONTEND_PROD_PORT=8091
